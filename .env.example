# ── Google Cloud ───────────────────────────────────────────────
GOOGLE_CLOUD_PROJECT=your-google-cloud-project
GOOGLE_CLOUD_LOCATION=us-central1

# ── Vertex AI Vector Search ────────────────────────────────────
VERTEX_API_ENDPOINT=
VERTEX_INDEX_ENDPOINT=
VERTEX_DEPLOYED_INDEX_ID=

# ── GCS ────────────────────────────────────────────────────────
GCS_VECTOR_BUCKET_URI=gs://your-project-vector-data

# ── Paths ──────────────────────────────────────────────────────
PROMPT_LIBRARY_PATH=normalized_data/layout_prompt_library_updated.json
RAW_TEXT_DATA_PATH=raw_data/LAS 4_V8_links_data with Descriptions.txt
EXCEL_FILE_PATH=raw_data/trainingData_Local.xlsx
VERTEX_INDEX_DATA_PATH=normalized_data/vertex_index_data.json
OUTPUT_FILE=outputs/generated_layout.json
FONT_LIST_PATH=raw_data/Font List.csv
TEMPLATE_DIR=templates
LOCAL_OUTPUT=true
# Set GCS_BUCKET to a bucket name to also upload the validated JSON.
# GCS_BUCKET=

# Inbound hosted API authentication (never reuse the publisher key)
LAYOUT_API_KEY=

# Publisher queue (set both URL and a rotated key to enable automatic submission)
PUBLISHER_API_URL=https://magazine-publisher-0f8b8f449e87.herokuapp.com/api/bubble/queue-job
PUBLISHER_API_KEY=
PUBLISHER_CREATED_BY=test_user@bubble.com
PUBLISHER_PROJECT=Heroku Integration Test

# ── Logging ────────────────────────────────────────────────────
LOG_DIR=logs
LOG_LEVEL=INFO
LOG_MAX_BYTES=10485760
LOG_BACKUP_COUNT=3

# ── Tracing ────────────────────────────────────────────────────
ENABLE_RUN_TRACE=true

# ── Models ────────────────────────────────────────────────────
EMBEDDING_MODEL=text-embedding-004
GENERATION_MODEL=gemini-2.5-flash
RERANKER_MODEL=cross-encoder/ms-marco-MiniLM-L-6-v2

# ── Generation ────────────────────────────────────────────────
GEMINI_TEMPERATURE=0.2

# ── Retrieval weights ─────────────────────────────────────────
VECTOR_WEIGHT=0.7
BM25_WEIGHT=0.3

# ── Retrieval top-k ───────────────────────────────────────────
TOP_K_VECTOR=10
TOP_K_BM25=10
TOP_K_MERGED=10
TOP_K_RERANKED=5
TOP_K_CONTEXT=2

# ── Retry ─────────────────────────────────────────────────────
MAX_RETRIES=3

# ── Index upsert (needed only for update_vector_index.py) ─────
# Fill this in after your index is created. Format:
# projects/{project_number}/locations/{location}/indexes/{index_id}
# VERTEX_INDEX_RESOURCE_NAME=
